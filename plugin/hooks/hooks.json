{
  "description": "jev: advisory judgments at the harness boundaries, addressed to Claude rather than to you. A hook can hand Claude a note about a call that already ran, or deny a call once with a reason Claude can answer by re-issuing it with `# jev:intended <why>`. None of them can emit permissionDecision \"allow\", and none of them prompts you unless you set ask_on_trip. Every hook exits 0 with empty stdout on any error. Set JEV_HOOKS_DISABLE=1 to turn all of them off, or gate=off for the tool gate alone.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" SessionStart",
            "timeout": 5,
            "statusMessage": "jev: checking configuration"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" UserPromptSubmit",
            "timeout": 5,
            "statusMessage": "jev: reading the request"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" PreToolUse",
            "timeout": 5,
            "statusMessage": "jev: checking this action"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "WebFetch|WebSearch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" PostToolUse",
            "timeout": 5,
            "statusMessage": "jev: screening this result"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" Approval",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" Approval",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/dist/hook.mjs\" Stop",
            "timeout": 5,
            "statusMessage": "jev: checking the final message"
          }
        ]
      }
    ]
  }
}
